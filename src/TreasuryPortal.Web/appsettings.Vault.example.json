{
  "Configuration": {
    "ConnectionStrings": {
      "PGSQLServer": "Host=<хост1>,<хост2>;Port=5432;Database=<база>;Username=<логин>;Password=<пароль>"
    },
    "UserRolesCacheTimoutSecond": 60,
    "HostNameCacheTimoutMinutes": 60,
    "Log": {
      "QueueCapacity": 10000,
      "ShutdownDrainSeconds": 5
    },
    "Events": {
      "Channel": "tp_events"
    },
    "ServiceLinks": {
      "B2Service": {
        "Endpoint": "https://<шина>/<адрес сервиса B2>",
        "User": "<логин портала на шине>",
        "PWD": "<пароль>",
        "Auth": "WsSecurity",
        "SoapVersion": "Soap11",
        "TimeoutSeconds": 15,
        "UseProxy": false,
        "Title": "B2",
        "Actions": {
          "getDeals4Treasury": "getDeals4Treasury"
        }
      }
    }
  }
}

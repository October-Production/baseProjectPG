{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Откуда приходят секреты на сервере. Строки подключения в репозитории нет.
  "VaultSettings": {
    "Address": "https://dcsensdbu03.sense.bank.int:8200",
    "MountPath": "dev-dcsensdbd01/TreasuryPortal",
    "MountPathGeneral": "dev-dcsensdbd01/General",
    "MountPoint": "kvCSence"
  },

  // Настройки приложения. Любой ключ отсюда можно выставить в Vault — значение из Vault
  // перекрывает здешнее, потому что VaultInit() подключается последним. Здесь — значения
  // по умолчанию. Строка подключения приходит только из Vault — и на сервере, и при отладке.
  // Имена ключей кэшей — те же, что в BanknoteOps и NBC.
  "Configuration": {
    "ConnectionStrings": {
      "PGSQLServer": ""
    },
    "UserRolesCacheTimoutSecond": 60,
    "HostNameCacheTimoutMinutes": 60,
    "Log": {
      "QueueCapacity": 10000,
      "ShutdownDrainSeconds": 5
    },
    // Канал pg_notify, по которому функции базы сообщают о событиях (db/README.md, раздел 7).
    // Пусто — портал события базы не слушает
    "Events": {
      "Channel": "tp_events"
    },
    // Внешние сервисы: раздел на сервис, имя раздела — имя сервиса в коде (AddExternalService).
    // Адрес, логин и пароль (Endpoint, User, PWD) приходят из Vault — ключи те же, что в kaznacms
    "ServiceLinks": {
      "B2Service": {
        "Title": "B2",
        "TimeoutSeconds": 15
      }
    }
  }
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Откуда приходят секреты на сервере. Строки подключения в репозитории нет.
  "VaultSettings": {
    "Address": "https://dcsensdbu03.sense.bank.int:8200",
    "MountPath": "dev-dcsensdbd01/TreasuryPortal",
    "MountPathGeneral": "dev-dcsensdbd01/General",
    "MountPoint": "kvCSence"
  },

  // Настройки приложения. Любой ключ отсюда можно выставить в Vault — значение из Vault
  // перекрывает здешнее, потому что VaultInit() подключается последним. Здесь — значения
  // по умолчанию. Строка подключения приходит из Vault, локально — из appsettings.Local.json
  // (он в .gitignore). Имена ключей кэшей — те же, что в BanknoteOps и NBC.
  "Configuration": {
    "ConnectionStrings": {
      "PGSQLServer": ""
    },
    "UserRolesCacheTimoutSecond": 60,
    "HostNameCacheTimoutMinutes": 60,
    "WriteLockWaitSeconds": 10,
    "Log": {
      "QueueCapacity": 10000,
      "ShutdownDrainSeconds": 5
    }
  }
}

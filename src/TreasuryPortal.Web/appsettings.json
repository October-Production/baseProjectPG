{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Откуда приходят секреты на сервере. Строки подключения в репозитории нет.
  "VaultSettings": {
    "Address": "https://dcsensdbu03.sense.bank.int:8200",
    "MountPath": "dev-dcsensdbd01/TreasuryPortal",
    "MountPathGeneral": "dev-dcsensdbd01/General",
    "MountPoint": "kvCSence"
  },

  // Слой данных. Configuration:ConnectionStrings:PGSQLServer приходит из Vault,
  // локально — из appsettings.Local.json (он в .gitignore).
  "Configuration": {
    "ConnectionStrings": {
      "PGSQLServer": ""
    },
    "WriteLockWaitSeconds": 10,
    "Log": {
      "QueueCapacity": 10000,
      "ShutdownDrainSeconds": 5
    }
  },

  "Auth": {
    "AccessCacheSeconds": 60,
    "HostNameCacheMinutes": 60
  }
}

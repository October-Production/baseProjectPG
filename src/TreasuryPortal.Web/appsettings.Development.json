{
  "Logging": {
    "LogLevel": {
      // шаги Negotiate-handshake на Kestrel
      "Microsoft.AspNetCore.Authentication": "Information"
    }
  },

  "Kestrel": {
    "EndpointDefaults": {
      // как IIS с выключенным HTTP/2: Negotiate работает только поверх HTTP/1.1
      "Protocols": "Http1"
    }
  },

  "Auth": {
    // Роли и права текущего пользователя вместо похода в базу. Удалите секцию Dev,
    // чтобы проверить настоящую выдачу. Пустые Roles — пользователь без доступа.
    "Dev": {
      "Roles": [ "TPReader", "TPWriter", "TPAdmin" ],
      "AllPermissions": true
    }
  },

  "Spa": {
    "DevServer": {
      // Всё, что не API, проксируется на ng serve. Без этой секции отдаётся собранный клиент из wwwroot.
      "Url": "http://localhost:4200"
    }
  }
}

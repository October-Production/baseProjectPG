<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- processPath/arguments при dotnet publish проставит SDK -->
      <aspNetCore processPath="dotnet" arguments=".\TreasuryPortal.Web.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
      <security>
        <requestFiltering removeServerHeader="true" />
        <!--
          Аутентификацию (Anonymous выкл., Windows вкл.) задаёт deploy/Install-IisSite.ps1
          в applicationHost.config. Секции system.webServer/security/authentication/* на сервере
          по умолчанию заблокированы: здесь они дали бы ошибку 500.19. Если админы их разблокировали
          (appcmd unlock config -section:system.webServer/security/authentication/windowsAuthentication
          и то же для anonymousAuthentication), настройку можно держать здесь:
          <authentication>
            <anonymousAuthentication enabled="false" />
            <windowsAuthentication enabled="true" />
          </authentication>
        -->
      </security>
    </system.webServer>
  </location>
</configuration>
